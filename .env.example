POSTGRES_DB=platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pass

# Use 5433 if a local PostgreSQL already listens on 5432.
POSTGRES_PORT=5432

# EF Core design-time factory reads this value when running dotnet ef commands.
# Keep this port in sync with POSTGRES_PORT.
PLATFORM_DB_CONNECTION=Host=localhost;Port=5432;Database=platform;Username=postgres;Password=pass
