@inherits LayoutComponentBase

<PageTitle>Платформа достижений</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center justify-content-end gap-3">
            <AuthorizeView>
                <Authorized Context="authenticationState">
                    <span class="text-muted small">
                        <span class="oi oi-person me-1" aria-hidden="true"></span>@authenticationState.User.Identity?.Name
                    </span>
                    <a class="btn btn-sm btn-outline-secondary" href="logout">
                        <span class="oi oi-account-logout me-1" aria-hidden="true"></span>Выйти
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-sm btn-primary" href="login">Войти</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
