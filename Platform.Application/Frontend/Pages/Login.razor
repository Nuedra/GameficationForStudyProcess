@page "/login"
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation
@inject IUserContextService UserContextService

<PageTitle>Вход — Платформа достижений</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="login-icon mb-2">🎓</div>
                    <h2 class="card-title mb-1">Платформа достижений</h2>
                    <p class="text-muted small mb-0">Введите ваш студенческий ID для входа</p>
                </div>

                <div class="mb-3">
                    <label for="studentId" class="form-label">ID студента</label>
                    <input type="text"
                           id="studentId"
                           class="form-control @(_error != null ? "is-invalid" : "")"
                           @bind="_studentId"
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDownAsync"
                           placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                           disabled="@_isLoading"
                           autocomplete="off" />
                    @if (_error != null)
                    {
                        <div class="invalid-feedback">@_error</div>
                    }
                </div>

                <button class="btn btn-primary w-100" @onclick="LoginAsync" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Вход...</span>
                    }
                    else
                    {
                        <span>Войти</span>
                    }
                </button>

                <p class="text-muted text-center mt-3 small mb-0">
                    Тестовый ID: <code>b0000000-0000-0000-0000-000000000001</code>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private string _studentId = "";
    private string? _error;
    private bool _isLoading;

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoginAsync();
    }

    private async Task LoginAsync()
    {
        _error = null;
        var input = _studentId.Trim();

        if (!Guid.TryParse(input, out _))
        {
            _error = "Некорректный формат ID. Ожидается GUID (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx).";
            return;
        }

        _isLoading = true;
        try
        {
            var result = await JsRuntime.InvokeAsync<LoginResult>("platformApi.login", input);

            if (!result.Success)
            {
                _error = result.Message ?? "Ошибка при входе. Проверьте ID и повторите.";
                return;
            }

            if (result.Student?.Id is Guid studentId)
                UserContextService.SetCurrentUserId(studentId);

            Navigation.NavigateTo("/");
        }
        catch
        {
            _error = "Не удалось выполнить вход. Проверьте подключение к серверу и повторите запрос.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private sealed class LoginResult
    {
        public bool Success { get; set; }
        public int Status { get; set; }
        public string? Message { get; set; }
        public StudentInfo? Student { get; set; }
    }

    private sealed class StudentInfo
    {
        public Guid? Id { get; set; }
        public string FullName { get; set; } = "";
        public string Group { get; set; } = "";
    }
}
