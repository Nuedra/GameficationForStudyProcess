@page "/profile"
@attribute [Authorize(Roles = "student")]
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Профиль студента — Платформа достижений</PageTitle>

<h1>Профиль студента</h1>

@if (_isLoading)
{
    <div class="d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">Загрузка...</span>
    </div>
}
else if (_error != null)
{
    <div class="alert alert-danger mt-3">
        @_error
        <button class="btn btn-outline-danger btn-sm ms-2" @onclick="LoadProfileAsync">Повторить</button>
    </div>
}
else if (_student == null)
{
    <div class="alert alert-warning mt-3">
        <span class="oi oi-warning me-2" aria-hidden="true"></span>
        Необходимо <a href="login">войти в систему</a>, чтобы просматривать профиль.
    </div>
}
else
{
    <div class="card profile-card mt-3" style="max-width: 480px;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center mb-3">
                <div class="profile-avatar me-3">
                    <span class="oi oi-person" aria-hidden="true"></span>
                </div>
                <div>
                    <h4 class="mb-0">@_student.DisplayName</h4>
                    <p class="text-muted mb-0">@_student.Group</p>
                </div>
            </div>
            <hr />
            <dl class="row mb-0">
                <dt class="col-sm-4">Группа</dt>
                <dd class="col-sm-8">@_student.Group</dd>
                <dt class="col-sm-4">ID</dt>
                <dd class="col-sm-8"><code class="small">@_student.Id</code></dd>
            </dl>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private StudentInfo? _student;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authenticationState.User;
            if (!user.TryGetUserId(out var userId))
            {
                _student = null;
                return;
            }

            _student = new StudentInfo
            {
                Id = userId,
                DisplayName = user.Identity?.Name ?? string.Empty,
                Group = user.FindFirst(PlatformClaimTypes.Group)?.Value ?? string.Empty
            };
        }
        catch
        {
            _error = "Не удалось получить данные текущего пользователя.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private sealed class StudentInfo
    {
        public Guid Id { get; set; }
        public string DisplayName { get; set; } = "";
        public string Group { get; set; } = "";
    }
}
