@page "/staff/courses/{CourseId:guid}/{Year:int}"
@attribute [Authorize(Roles = "teacher,administrator")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStaffCourseService StaffCourseService
@inject ITeachingAssignmentService TeachingAssignmentService

<PageTitle>Кабинет курса — Платформа достижений</PageTitle>

@if (_isLoading)
{
    <div class="d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">Проверка доступа...</span>
    </div>
}
else if (_error is not null)
{
    <div class="alert alert-danger mt-3">@_error</div>
    <a class="btn btn-outline-secondary" href="staff/courses">Вернуться к курсам</a>
}
else if (_course is not null)
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="mb-1">@_course.Title</h1>
            <p class="text-muted mb-0">Экземпляр курса за @_course.Year год</p>
        </div>
        @if (_isAdministrator)
        {
            <span class="badge bg-primary fs-6">Администрирование</span>
        }
        else
        {
            <span class="badge bg-primary fs-6">Управление достижениями</span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_course.Description))
    {
        <p>@_course.Description</p>
    }

    <section class="mb-4" aria-labelledby="course-exports-title">
        <div class="border-top border-bottom py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h2 id="course-exports-title" class="h5 mb-1">Выгрузки курса</h2>
                    <p class="text-muted small mb-0">
                        Полный архив содержит достижения, граф, студентов, выдачи, аудит и таблицу лидеров.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @if (!_isAdministrator)
                    {
                        <a class="btn btn-outline-primary"
                           href="api/staff/courses/@CourseId/@Year/exports/teacher-report.csv"
                           download>
                            <span class="oi oi-data-transfer-download me-1" aria-hidden="true"></span>
                            Скачать таблицу CSV
                        </a>
                    }
                    <a class="btn btn-primary"
                       href="api/staff/courses/@CourseId/@Year/exports/archive.zip"
                       download>
                        <span class="oi oi-data-transfer-download me-1" aria-hidden="true"></span>
                        Скачать полный ZIP
                    </a>
                </div>
            </div>
        </div>
    </section>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100"><div class="card-body">
                <h5 class="card-title">Достижения</h5>
                <p class="text-muted">Создание достижений, настройка редкости и критериев получения.</p>
                <a class="btn btn-primary" href="staff/courses/@CourseId/@Year/achievements">
                    Управлять достижениями
                </a>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card h-100"><div class="card-body">
                <h5 class="card-title">Граф</h5>
                <p class="text-muted mb-0">Черновики, валидация и публикация будут добавлены позднее.</p>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card h-100"><div class="card-body">
                <h5 class="card-title">Студенты</h5>
                <p class="text-muted mb-0">Состав курса остаётся read-only данными LMS.</p>
            </div></div>
        </div>
    </div>

    @if (_isAdministrator)
    {
        <section class="mt-4" aria-labelledby="teaching-assignments-title">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 id="teaching-assignments-title" class="h4 mb-1">Преподаватели курса</h2>
                    <p class="text-muted mb-0">
                        Назначения относятся именно к этому экземпляру курса и учитывают период действия.
                    </p>
                </div>
            </div>

            @if (_assignmentsLoading)
            {
                <div class="d-flex align-items-center gap-2">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="text-muted">Загрузка назначений...</span>
                </div>
            }
            else
            {
                @if (_assignmentError is not null)
                {
                    <div class="alert alert-danger">@_assignmentError</div>
                }
                @if (_assignmentSuccess is not null)
                {
                    <div class="alert alert-success">@_assignmentSuccess</div>
                }
                @if (_assignmentToEnd is not null)
                {
                    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span>Завершить назначение преподавателя «@_assignmentToEnd.TeacherName» текущим моментом?</span>
                        <span class="d-flex gap-2">
                            <button class="btn btn-sm btn-danger" disabled="@_assignmentSaving"
                                    @onclick="ConfirmEndAssignmentAsync">Завершить</button>
                            <button class="btn btn-sm btn-outline-secondary" disabled="@_assignmentSaving"
                                    @onclick="CancelEndAssignment">Отмена</button>
                        </span>
                    </div>
                }

                <div class="card mb-3">
                    <div class="card-body">
                        <h3 class="h5">Назначить или изменить преподавателя</h3>
                        @if (_availableTeachers.Count == 0)
                        {
                            <p class="text-muted mb-0">
                                В конфигурации нет активных пользователей с ролью преподавателя.
                            </p>
                        }
                        else
                        {
                            <div class="row g-3 align-items-end">
                                <div class="col-lg-4">
                                    <label class="form-label" for="teacher-select">Преподаватель</label>
                                    <select id="teacher-select" class="form-select" @bind="_selectedTeacherId">
                                        @foreach (var teacher in _availableTeachers)
                                        {
                                            <option value="@teacher.Id">@teacher.DisplayName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4 col-lg-2">
                                    <label class="form-label" for="assignment-start">Дата начала</label>
                                    <input id="assignment-start" class="form-control" type="date"
                                           value="@_startDate"
                                           @onchange="eventArgs => _startDate = eventArgs.Value?.ToString() ?? string.Empty" />
                                </div>
                                <div class="col-md-4 col-lg-2">
                                    <label class="form-label" for="assignment-end">Дата окончания</label>
                                    <input id="assignment-end" class="form-control" type="date"
                                           value="@_endDate"
                                           @onchange="eventArgs => _endDate = eventArgs.Value?.ToString() ?? string.Empty" />
                                </div>
                                <div class="col-md-4 col-lg-2">
                                    <div class="form-check mb-2">
                                        <input id="assignment-lead" class="form-check-input" type="checkbox" @bind="_isLead" />
                                        <label class="form-check-label" for="assignment-lead">Ведущий</label>
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <button class="btn btn-primary w-100"
                                            disabled="@_assignmentSaving"
                                            @onclick="SaveAssignmentAsync">
                                        @(_assignmentSaving ? "Сохранение..." : "Сохранить")
                                    </button>
                                </div>
                            </div>
                            <div class="form-text mt-2">
                                Пустая дата окончания означает бессрочное назначение. Повторное сохранение изменяет существующую запись.
                            </div>
                        }
                    </div>
                </div>

                @if (_assignments.Count == 0)
                {
                    <div class="alert alert-secondary">На курс ещё не назначены преподаватели.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">Преподаватель</th>
                                    <th scope="col">Роль</th>
                                    <th scope="col">Период</th>
                                    <th scope="col">Состояние</th>
                                    <th scope="col" class="text-end">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var assignment in _assignments)
                                {
                                    <tr>
                                        <td>
                                            <div>@assignment.TeacherName</div>
                                            <small class="text-muted">@assignment.TeacherId</small>
                                        </td>
                                        <td>@(assignment.IsLead ? "Ведущий" : "Ассистент")</td>
                                        <td>
                                            @FormatDate(assignment.StartDate) —
                                            @(assignment.EndDate.HasValue ? FormatDate(assignment.EndDate.Value) : "без окончания")
                                        </td>
                                        <td>
                                            <span class="badge @(assignment.IsActive ? "bg-success" : "bg-secondary")">
                                                @(assignment.IsActive ? "Действует" : "Не действует")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary me-2"
                                                    disabled="@_assignmentSaving"
                                                    @onclick="() => EditAssignment(assignment)">
                                                Изменить
                                            </button>
                                            @if (assignment.IsActive)
                                            {
                                                <button class="btn btn-sm btn-outline-danger"
                                                        disabled="@_assignmentSaving"
                                                        @onclick="() => RequestEndAssignment(assignment)">
                                                    Завершить
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </section>
    }
}

@code {
    [Parameter] public Guid CourseId { get; set; }
    [Parameter] public int Year { get; set; }

    private bool _isLoading = true;
    private bool _isAdministrator;
    private Guid _currentUserId;
    private UserRole _currentRole;
    private CourseDto? _course;
    private string? _error;
    private bool _assignmentsLoading;
    private bool _assignmentSaving;
    private string? _assignmentError;
    private string? _assignmentSuccess;
    private string _selectedTeacherId = string.Empty;
    private string _startDate = DateTimeOffset.Now.ToString("yyyy-MM-dd");
    private string _endDate = string.Empty;
    private bool _isLead;
    private List<TeacherOptionDto> _availableTeachers = [];
    private List<TeachingAssignmentDto> _assignments = [];
    private TeachingAssignmentDto? _assignmentToEnd;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authenticationState.User.TryGetUserId(out _currentUserId) ||
            !authenticationState.User.TryGetUserRole(out _currentRole))
        {
            _error = "Не удалось определить текущего пользователя.";
            _isLoading = false;
            return;
        }

        _isAdministrator = _currentRole == UserRole.Administrator;
        await LoadCourseAsync();
        if (_course is not null && _isAdministrator)
            await LoadAssignmentsAsync();
    }

    private async Task LoadAssignmentsAsync()
    {
        _assignmentsLoading = true;
        _assignmentError = null;
        try
        {
            var result = await TeachingAssignmentService.GetAsync(
                _currentUserId,
                _currentRole,
                CourseId,
                Year);
            if (result.Status == TeachingAssignmentStatus.Success && result.Management is not null)
                ApplyManagement(result.Management);
            else
                _assignmentError = AssignmentError(result.Status, "Не удалось загрузить назначения преподавателей.");
        }
        catch
        {
            _assignmentError = "Не удалось загрузить назначения преподавателей.";
        }
        finally
        {
            _assignmentsLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveAssignmentAsync()
    {
        _assignmentError = null;
        _assignmentSuccess = null;
        if (!Guid.TryParse(_selectedTeacherId, out var teacherId) ||
            !DateOnly.TryParse(_startDate, out var startDate) ||
            (!string.IsNullOrWhiteSpace(_endDate) && !DateOnly.TryParse(_endDate, out _)))
        {
            _assignmentError = "Выберите преподавателя и дату начала.";
            return;
        }

        _assignmentSaving = true;
        try
        {
            DateTimeOffset? endDate = null;
            if (DateOnly.TryParse(_endDate, out var parsedEndDate))
                endDate = new DateTimeOffset(parsedEndDate.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero);

            var result = await TeachingAssignmentService.SaveAsync(
                _currentUserId,
                _currentRole,
                CourseId,
                Year,
                teacherId,
                new SaveTeachingAssignmentRequest(
                    new DateTimeOffset(startDate.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero),
                    endDate,
                    _isLead));
            if (result.Status == TeachingAssignmentStatus.Success && result.Management is not null)
            {
                ApplyManagement(result.Management);
                _assignmentSuccess = "Назначение преподавателя сохранено.";
            }
            else
            {
                _assignmentError = AssignmentError(result.Status, "Не удалось сохранить назначение преподавателя.");
            }
        }
        catch
        {
            _assignmentError = "Не удалось сохранить назначение преподавателя.";
        }
        finally
        {
            _assignmentSaving = false;
        }
    }

    private void RequestEndAssignment(TeachingAssignmentDto assignment)
    {
        _assignmentToEnd = assignment;
        _assignmentError = null;
        _assignmentSuccess = null;
    }

    private void CancelEndAssignment()
    {
        _assignmentToEnd = null;
    }

    private async Task ConfirmEndAssignmentAsync()
    {
        if (_assignmentToEnd is null)
            return;

        var assignment = _assignmentToEnd;
        _assignmentSaving = true;
        _assignmentError = null;
        _assignmentSuccess = null;
        try
        {
            var result = await TeachingAssignmentService.EndAsync(
                _currentUserId,
                _currentRole,
                CourseId,
                Year,
                assignment.TeacherId);
            if (result.Status == TeachingAssignmentStatus.Success && result.Management is not null)
            {
                ApplyManagement(result.Management);
                _assignmentToEnd = null;
                _assignmentSuccess = "Назначение преподавателя завершено.";
            }
            else
            {
                _assignmentError = AssignmentError(result.Status, "Не удалось завершить назначение преподавателя.");
            }
        }
        catch
        {
            _assignmentError = "Не удалось завершить назначение преподавателя.";
        }
        finally
        {
            _assignmentSaving = false;
        }
    }

    private void EditAssignment(TeachingAssignmentDto assignment)
    {
        _selectedTeacherId = assignment.TeacherId.ToString();
        _startDate = assignment.StartDate.ToString("yyyy-MM-dd");
        _endDate = assignment.EndDate?.ToString("yyyy-MM-dd") ?? string.Empty;
        _isLead = assignment.IsLead;
        _assignmentError = null;
        _assignmentSuccess = "Данные назначения перенесены в форму. Измените их и нажмите «Сохранить».";
    }

    private void ApplyManagement(TeachingAssignmentManagementDto management)
    {
        _availableTeachers = management.AvailableTeachers.ToList();
        _assignments = management.Assignments.ToList();
        if (string.IsNullOrWhiteSpace(_selectedTeacherId) && _availableTeachers.Count > 0)
            _selectedTeacherId = _availableTeachers[0].Id.ToString();
    }

    private static string FormatDate(DateTimeOffset date) => date.ToString("dd.MM.yyyy");

    private async Task LoadCourseAsync()
    {
        try
        {
            var result = await StaffCourseService.GetCourseAsync(
                _currentUserId,
                _currentRole,
                CourseId,
                Year);
            if (result.Status == StaffCourseQueryStatus.Success)
                _course = result.Course;
            else
                _error = result.Status == StaffCourseQueryStatus.CourseNotFound
                    ? "Экземпляр курса не найден."
                    : "У вас нет доступа к этому экземпляру курса.";
        }
        catch
        {
            _error = "Не удалось открыть экземпляр курса.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private static string AssignmentError(TeachingAssignmentStatus status, string fallback)
    {
        return status switch
        {
            TeachingAssignmentStatus.AccessDenied => "У вас нет доступа к управлению назначениями.",
            TeachingAssignmentStatus.CourseNotFound => "Экземпляр курса не найден.",
            TeachingAssignmentStatus.TeacherNotFound => "Активный преподаватель с таким ID не найден.",
            TeachingAssignmentStatus.AssignmentNotFound => "Назначение преподавателя не найдено.",
            TeachingAssignmentStatus.AssignmentNotActive => "Назначение уже не действует.",
            TeachingAssignmentStatus.InvalidPeriod => "Дата окончания должна быть позже даты начала.",
            TeachingAssignmentStatus.LeadAssignmentConflict => "На этот период уже назначен ведущий преподаватель.",
            _ => fallback
        };
    }
}
