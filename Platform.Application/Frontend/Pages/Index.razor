@page "/"
@inject IJSRuntime JsRuntime

<PageTitle>Главная — Платформа достижений</PageTitle>

<h1 class="mb-1">Платформа достижений</h1>
<p class="lead text-muted mb-4">
    Система геймификации учебного процесса — отслеживайте прогресс и получайте достижения в процессе обучения.
</p>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-0 bg-light">
            <div class="card-body">
                <div class="fs-2 mb-2">🏆</div>
                <h5 class="card-title">Граф достижений</h5>
                <p class="card-text text-muted">
                    Прогресс отображается в виде интерактивного графа. Выполняйте задания, открывайте новые узлы и продвигайтесь к финальным достижениям.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 bg-light">
            <div class="card-body">
                <div class="fs-2 mb-2">📊</div>
                <h5 class="card-title">Статусы ачивок</h5>
                <p class="card-text text-muted">
                    Каждое достижение имеет статус: <strong>заработанное</strong>, <strong>доступное для получения</strong> или <strong>заблокированное</strong>. Вы всегда видите, что уже сделано и что впереди.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 bg-light">
            <div class="card-body">
                <div class="fs-2 mb-2">🎓</div>
                <h5 class="card-title">По курсам</h5>
                <p class="card-text text-muted">
                    Достижения привязаны к учебным курсам. Каждый курс имеет собственный граф с уникальной структурой задач.
                </p>
            </div>
        </div>
    </div>
</div>

<hr class="mb-4" />

<h5 class="mb-3">Как пользоваться</h5>
<ol class="text-muted">
    <li class="mb-1">Войдите в систему по своему студенческому ID.</li>
    <li class="mb-1">Перейдите во вкладку <strong>Достижения</strong> и выберите курс.</li>
    <li class="mb-1">Изучите граф: зелёные узлы — уже заработанные, жёлтые — доступны сейчас, серые — ещё заблокированы.</li>
    <li>После выполнения заданий нажмите <strong>Обновить граф</strong>, чтобы увидеть новый прогресс.</li>
</ol>

@if (!_isAuthenticated)
{
    <div class="mt-4">
        <a href="login" class="btn btn-primary px-4">Войти в систему</a>
    </div>
}

@code {
    private bool _isAuthenticated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var session = await JsRuntime.InvokeAsync<SessionResult>("platformApi.getCurrentStudent");
            _isAuthenticated = session.Success;
        }
        catch
        {
            _isAuthenticated = false;
        }
        StateHasChanged();
    }

    private sealed class SessionResult
    {
        public bool Success { get; set; }
    }
}
