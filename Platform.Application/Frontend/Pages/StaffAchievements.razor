@page "/staff/courses/{CourseId:guid}/{Year:int}/achievements"
@attribute [Authorize(Roles = "teacher,administrator")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAchievementManagementService AchievementManagementService

<PageTitle>Достижения курса — Платформа достижений</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <a class="text-decoration-none" href="staff/courses/@CourseId/@Year">← Вернуться в кабинет курса</a>
        <h1 class="mt-2 mb-1">Достижения и критерии</h1>
        <p class="text-muted mb-0">Экземпляр курса за @Year год</p>
    </div>
    <button class="btn btn-primary" @onclick="StartCreate">Новое достижение</button>
</div>

@if (_isLoading)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">Загрузка достижений...</span>
    </div>
}
else
{
    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (_message is not null)
    {
        <div class="alert alert-success">@_message</div>
    }
    @if (_achievementToDelete is not null)
    {
        <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>
                @if (_achievementToDelete.AwardCount > 0)
                {
                    @($"Удалить «{_achievementToDelete.Title}» и отозвать его у {_achievementToDelete.AwardCount} студентов?")
                }
                else
                {
                    @($"Удалить достижение «{_achievementToDelete.Title}»?")
                }
            </span>
            <span class="d-flex gap-2">
                <button class="btn btn-sm btn-danger" disabled="@_isSaving"
                        @onclick="ConfirmDeleteAchievementAsync">Удалить</button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@_isSaving"
                        @onclick="CancelDeleteAchievement">Отмена</button>
            </span>
        </div>
    }
    @if (_awardToRevoke is not null)
    {
        <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Отозвать ачивку у студента <code>@_awardToRevoke.StudentId</code>? Студент сможет получить её повторно.</span>
            <span class="d-flex gap-2">
                <button class="btn btn-sm btn-danger" disabled="@_isSaving"
                        @onclick="ConfirmRevokeAwardAsync">Отозвать</button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@_isSaving"
                        @onclick="CancelRevokeAward">Отмена</button>
            </span>
        </div>
    }

    <div class="row g-4">
        <div class="col-xl-7">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h2 class="h4 mb-0">Достижения (@_achievements.Count)</h2>
                        <input class="form-control" style="max-width: 20rem"
                               placeholder="Поиск по названию"
                               @bind="_search" @bind:event="oninput" />
                    </div>

                    @if (FilteredAchievements.Count == 0)
                    {
                        <div class="alert alert-secondary mb-0">Достижения не найдены.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col">Название</th>
                                        <th scope="col">Редкость</th>
                                        <th scope="col">Критерий</th>
                                        <th scope="col" class="text-end">Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var achievement in FilteredAchievements)
                                    {
                                        <tr class="@(achievement.Id == _selectedAchievementId ? "table-primary" : null)">
                                            <td>
                                                <div class="fw-semibold">@achievement.Title</div>
                                                <small class="text-muted">@achievement.Track</small>
                                                @if (achievement.AwardCount > 0)
                                                {
                                                    <button type="button"
                                                            class="badge bg-info text-dark border-0 ms-1"
                                                            title="Показать студентов"
                                                            disabled="@_isSaving"
                                                            @onclick="() => ToggleAwardsAsync(achievement)">
                                                        выдано: @achievement.AwardCount
                                                    </button>
                                                }
                                                @if (achievement.HasDependencies)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1">есть связи</span>
                                                }
                                            </td>
                                            <td>@RarityLabel(achievement.Rarity)</td>
                                            <td>
                                                @if (achievement.Criteria is null)
                                                {
                                                    <span class="text-muted">Не задан</span>
                                                }
                                                else
                                                {
                                                    <span class="badge @(achievement.Criteria.IsEnabled ? "bg-success" : "bg-secondary")">
                                                        @(achievement.Criteria.IsEnabled ? "Включён" : "Отключён")
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end text-nowrap">
                                                <button class="btn btn-sm btn-outline-primary me-2"
                                                        @onclick="() => SelectAchievement(achievement)">
                                                    Изменить
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        disabled="@(achievement.HasDependencies || _isSaving)"
                                                        title="@(achievement.HasDependencies ? "Сначала удалите связи графа" : null)"
                                                        @onclick="() => RequestDeleteAchievement(achievement)">
                                                    Удалить
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (_awardAchievementId.HasValue)
                    {
                        <div class="border rounded p-3 mt-3">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div>
                                    <h3 class="h6 mb-1">Студенты, получившие ачивку</h3>
                                    <div class="text-muted small">@_awardAchievementTitle</div>
                                </div>
                                <button type="button" class="btn-close" aria-label="Закрыть"
                                        @onclick="CloseAwards"></button>
                            </div>

                            @if (_awardsLoading)
                            {
                                <div class="text-muted small">Загрузка...</div>
                            }
                            else if (_awards.Count == 0)
                            {
                                <div class="text-muted small">Активных выдач нет.</div>
                            }
                            else
                            {
                                <div class="list-group">
                                    @foreach (var award in _awards)
                                    {
                                        <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <code>@award.StudentId</code>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    disabled="@_isSaving"
                                                    @onclick="() => RequestRevokeAward(award)">
                                                Отозвать
                                            </button>
                                        </div>
                                    }
                                </div>
                            }

                            <p class="text-muted small mb-0 mt-2">
                                После отзыва студент сможет получить ачивку снова, если критерий будет выполнен при следующей обработке.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h4">@(_selectedAchievementId.HasValue ? "Редактирование достижения" : "Новое достижение")</h2>
                    <div class="mb-3">
                        <label class="form-label" for="achievement-title">Название</label>
                        <input id="achievement-title" class="form-control" maxlength="200" @bind="_title" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="achievement-description">Описание</label>
                        <textarea id="achievement-description" class="form-control" rows="3" maxlength="2000" @bind="_description"></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="achievement-rarity">Редкость</label>
                            <select id="achievement-rarity" class="form-select" @bind="_rarity">
                                <option value="common">Обычная</option>
                                <option value="rare">Редкая</option>
                                <option value="epic">Эпическая</option>
                                <option value="legendary">Легендарная</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="achievement-track">Трек</label>
                            <input id="achievement-track" class="form-control" maxlength="100" @bind="_track" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label" for="achievement-lab">ID лабораторной работы</label>
                        <input id="achievement-lab" class="form-control" placeholder="Необязательно, GUID" @bind="_labId" />
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary" disabled="@_isSaving" @onclick="SaveAchievementAsync">
                            @(_isSaving ? "Сохранение..." : "Сохранить достижение")
                        </button>
                        @if (_selectedAchievementId.HasValue)
                        {
                            <button class="btn btn-outline-secondary" disabled="@_isSaving" @onclick="StartCreate">Отмена</button>
                        }
                    </div>
                </div>
            </div>

            @if (_selectedAchievementId.HasValue)
            {
                <div class="card">
                    <div class="card-body">
                        <h2 class="h4">Критерий получения</h2>
                        <p class="text-muted small">
                            Укажите теги ведомости через запятую. Пустой критерий не сохраняется.
                        </p>
                        <div class="mb-3">
                            <label class="form-label" for="criteria-expression">Выражение</label>
                            <textarea id="criteria-expression" class="form-control" rows="3" maxlength="1000"
                                      placeholder="например: lab_completed, score_high"
                                      @bind="_criteriaExpression"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="criteria-scope">Область проверки</label>
                            <select id="criteria-scope" class="form-select" @bind="_criteriaScope">
                                <option value="SameMark">Одна отметка</option>
                                <option value="AcrossCourse">Весь курс</option>
                                <option value="AllLabs">Все лабораторные</option>
                            </select>
                        </div>
                        <div class="form-check mb-3">
                            <input id="criteria-enabled" class="form-check-input" type="checkbox" @bind="_criteriaEnabled" />
                            <label class="form-check-label" for="criteria-enabled">Критерий включён</label>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" disabled="@_isSaving" @onclick="SaveCriteriaAsync">
                                Сохранить критерий
                            </button>
                            @if (_selectedAchievement?.Criteria is not null)
                            {
                                <button class="btn btn-outline-danger" disabled="@_isSaving" @onclick="RequestDeleteCriteria">
                                    Удалить критерий
                                </button>
                            }
                        </div>
                        @if (_confirmCriteriaDelete)
                        {
                            <div class="alert alert-warning mt-3 mb-0">
                                <p>Удалить критерий? Достижение перестанет выдаваться автоматически.</p>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-danger" disabled="@_isSaving"
                                            @onclick="ConfirmDeleteCriteriaAsync">Удалить</button>
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@_isSaving"
                                            @onclick="CancelDeleteCriteria">Отмена</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h2 class="h4 mb-1">Аудит выдач и отзывов</h2>
                    <p class="text-muted small mb-0">
                        Последние 100 событий курса. Записи сохраняются после отзыва и удаления достижения.
                    </p>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        disabled="@_auditLoading" @onclick="() => LoadAuditAsync()">
                    @(_auditLoading ? "Обновление..." : "Обновить журнал")
                </button>
            </div>

            @if (_auditLoading && _auditEvents.Count == 0)
            {
                <div class="text-muted">Загрузка журнала...</div>
            }
            else if (_auditEvents.Count == 0)
            {
                <div class="alert alert-secondary mb-0">Событий выдачи и отзыва пока нет.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Время события</th>
                                <th scope="col">Событие</th>
                                <th scope="col">Достижение</th>
                                <th scope="col">Студент</th>
                                <th scope="col">Исполнитель и основание</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var auditEvent in _auditEvents)
                            {
                                <tr>
                                    <td class="text-nowrap">@FormatAuditDate(auditEvent.OccurredAt)</td>
                                    <td>
                                        <span class="badge @(auditEvent.EventType == AchievementAwardAuditEventType.Granted ? "bg-success" : "bg-danger")">
                                            @AuditEventLabel(auditEvent.EventType)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@auditEvent.AchievementTitle</div>
                                        <code class="small">@auditEvent.AchievementId</code>
                                    </td>
                                    <td><code class="small">@auditEvent.StudentId</code></td>
                                    <td>
                                        <div>@AuditActorLabel(auditEvent)</div>
                                        <small class="text-muted">@AuditReasonLabel(auditEvent.Reason)</small>
                                        @if (!string.IsNullOrWhiteSpace(auditEvent.CriterionExpression))
                                        {
                                            <div class="small">Критерий: <code>@auditEvent.CriterionExpression</code></div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid CourseId { get; set; }
    [Parameter] public int Year { get; set; }

    private bool _isLoading = true;
    private bool _isSaving;
    private Guid _currentUserId;
    private UserRole _currentRole;
    private string? _error;
    private string? _message;
    private string _search = string.Empty;
    private List<ManagedAchievementDto> _achievements = [];
    private Guid? _selectedAchievementId;
    private ManagedAchievementDto? _selectedAchievement;
    private string _title = string.Empty;
    private string _description = string.Empty;
    private string _rarity = "common";
    private string _track = "default";
    private string _labId = string.Empty;
    private string _criteriaExpression = string.Empty;
    private string _criteriaScope = "SameMark";
    private bool _criteriaEnabled = true;
    private Guid? _awardAchievementId;
    private string _awardAchievementTitle = string.Empty;
    private bool _awardsLoading;
    private List<ManagedAchievementAwardDto> _awards = [];
    private ManagedAchievementDto? _achievementToDelete;
    private ManagedAchievementAwardDto? _awardToRevoke;
    private bool _confirmCriteriaDelete;
    private bool _auditLoading;
    private List<AchievementAwardAuditEventDto> _auditEvents = [];

    private List<ManagedAchievementDto> FilteredAchievements => _achievements
        .Where(achievement => string.IsNullOrWhiteSpace(_search) ||
            achievement.Title.Contains(_search, StringComparison.CurrentCultureIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authenticationState.User.TryGetUserId(out _currentUserId) ||
            !authenticationState.User.TryGetUserRole(out _currentRole))
        {
            _error = "Не удалось определить текущего пользователя.";
            _isLoading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var result = await AchievementManagementService.GetAllAsync(
                _currentUserId,
                _currentRole,
                CourseId,
                Year);
            if (result.Status == AchievementManagementStatus.Success)
            {
                _achievements = result.Achievements?.ToList() ?? [];
                await LoadAuditAsync(false);
            }
            else
                _error = AchievementError(result.Status, "Не удалось загрузить достижения курса.");
        }
        catch
        {
            _error = "Не удалось загрузить достижения курса.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void StartCreate()
    {
        _selectedAchievementId = null;
        _selectedAchievement = null;
        _title = string.Empty;
        _description = string.Empty;
        _rarity = "common";
        _track = "default";
        _labId = string.Empty;
        ResetCriteria();
        ClearNotifications();
    }

    private void SelectAchievement(ManagedAchievementDto achievement)
    {
        _selectedAchievementId = achievement.Id;
        _selectedAchievement = achievement;
        _title = achievement.Title;
        _description = achievement.Description;
        _rarity = achievement.Rarity.ToString().ToLowerInvariant();
        _track = achievement.Track;
        _labId = achievement.LabId?.ToString() ?? string.Empty;
        _criteriaExpression = achievement.Criteria?.Expression ?? string.Empty;
        _criteriaScope = achievement.Criteria?.Scope.ToString() ?? "SameMark";
        _criteriaEnabled = achievement.Criteria?.IsEnabled ?? true;
        ClearNotifications();
    }

    private async Task SaveAchievementAsync()
    {
        ClearNotifications();
        if (string.IsNullOrWhiteSpace(_title))
        {
            _error = "Укажите название достижения.";
            return;
        }

        Guid? labId = null;
        if (!string.IsNullOrWhiteSpace(_labId))
        {
            if (!Guid.TryParse(_labId, out var parsedLabId))
            {
                _error = "ID лабораторной работы должен иметь формат GUID.";
                return;
            }
            labId = parsedLabId;
        }
        if (!Enum.TryParse<AchievementRarity>(_rarity, true, out var rarity))
        {
            _error = "Выберите корректную редкость достижения.";
            return;
        }

        _isSaving = true;
        try
        {
            var request = new SaveAchievementRequest(
                _title,
                _description,
                rarity,
                _track,
                labId);
            var result = _selectedAchievementId.HasValue
                ? await AchievementManagementService.UpdateAsync(
                    _currentUserId,
                    _currentRole,
                    CourseId,
                    Year,
                    _selectedAchievementId.Value,
                    request)
                : await AchievementManagementService.CreateAsync(
                    _currentUserId,
                    _currentRole,
                    CourseId,
                    Year,
                    request);
            if (result.Status == AchievementManagementStatus.Success && result.Achievement is not null)
            {
                Upsert(result.Achievement);
                SelectAchievement(result.Achievement);
                _message = "Достижение сохранено.";
            }
            else
            {
                _error = AchievementError(result.Status, "Не удалось сохранить достижение.");
            }
        }
        catch
        {
            _error = "Не удалось сохранить достижение.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveCriteriaAsync()
    {
        if (!_selectedAchievementId.HasValue)
            return;

        ClearNotifications();
        if (!Enum.TryParse<AchievementCriteriaScope>(_criteriaScope, true, out var criteriaScope))
        {
            _error = "Выберите корректную область проверки.";
            return;
        }
        _isSaving = true;
        try
        {
            var result = await AchievementManagementService.SaveCriteriaAsync(
                _currentUserId,
                _currentRole,
                CourseId,
                Year,
                _selectedAchievementId.Value,
                new SaveAchievementCriteriaRequest(
                    _criteriaExpression,
                    criteriaScope,
                    _criteriaEnabled));
            if (result.Status == AchievementManagementStatus.Success && result.Achievement is not null)
            {
                Upsert(result.Achievement);
                SelectAchievement(result.Achievement);
                _message = "Критерий сохранён.";
            }
            else
            {
                _error = AchievementError(result.Status, "Не удалось сохранить критерий.");
            }
        }
        catch
        {
            _error = "Не удалось сохранить критерий.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void RequestDeleteAchievement(ManagedAchievementDto achievement)
    {
        _achievementToDelete = achievement;
        _awardToRevoke = null;
        ClearNotifications();
    }

    private void CancelDeleteAchievement()
    {
        _achievementToDelete = null;
    }

    private async Task ConfirmDeleteAchievementAsync()
    {
        if (_achievementToDelete is null)
            return;

        var achievement = _achievementToDelete;
        ClearNotifications();
        _isSaving = true;
        try
        {
            var result = await AchievementManagementService.DeleteAsync(
                _currentUserId,
                _currentRole,
                CourseId,
                Year,
                achievement.Id,
                achievement.AwardCount > 0);
            if (result.Status == AchievementManagementStatus.Success)
            {
                _achievements.RemoveAll(item => item.Id == achievement.Id);
                _achievementToDelete = null;
                if (_awardAchievementId == achievement.Id)
                    CloseAwards();
                if (_selectedAchievementId == achievement.Id)
                    StartCreate();
                if (achievement.AwardCount > 0)
                    await LoadAuditAsync(false);
                _message = achievement.AwardCount > 0
                    ? "Достижение удалено, связанные выдачи отозваны."
                    : "Достижение удалено.";
            }
            else
            {
                _error = AchievementError(result.Status, "Не удалось удалить достижение.");
            }
        }
        catch
        {
            _error = "Не удалось удалить достижение.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ToggleAwardsAsync(ManagedAchievementDto achievement)
    {
        if (_awardAchievementId == achievement.Id)
        {
            CloseAwards();
            return;
        }

        _awardAchievementId = achievement.Id;
        _awardAchievementTitle = achievement.Title;
        _awards = [];
        _awardsLoading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var result = await AchievementManagementService.GetAwardsAsync(
                _currentUserId,
                _currentRole,
                CourseId,
                Year,
                achievement.Id);
            if (result.Status == AchievementManagementStatus.Success)
                _awards = result.Awards?.ToList() ?? [];
            else
                _error = AchievementError(result.Status, "Не удалось загрузить список студентов.");
        }
        catch
        {
            _error = "Не удалось загрузить список студентов.";
        }
        finally
        {
            _awardsLoading = false;
        }
    }

    private void RequestRevokeAward(ManagedAchievementAwardDto award)
    {
        _awardToRevoke = award;
        _achievementToDelete = null;
        ClearNotifications();
    }

    private void CancelRevokeAward()
    {
        _awardToRevoke = null;
    }

    private async Task ConfirmRevokeAwardAsync()
    {
        if (!_awardAchievementId.HasValue || _awardToRevoke is null)
            return;

        var award = _awardToRevoke;
        ClearNotifications();
        _isSaving = true;
        try
        {
            var result = await AchievementManagementService.RevokeAwardAsync(
                _currentUserId,
                _currentRole,
                CourseId,
                Year,
                _awardAchievementId.Value,
                award.StudentId);
            if (result.Status == AchievementManagementStatus.Success && result.Achievement is not null)
            {
                _awards.RemoveAll(item => item.StudentId == award.StudentId);
                _awardToRevoke = null;
                Upsert(result.Achievement);
                if (_selectedAchievementId == result.Achievement.Id)
                    _selectedAchievement = result.Achievement;
                await LoadAuditAsync(false);
                _message = $"Ачивка отозвана у студента {award.StudentId}.";
            }
            else
            {
                _error = AchievementError(result.Status, "Не удалось отозвать ачивку у студента.");
            }
        }
        catch
        {
            _error = "Не удалось отозвать ачивку у студента.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void CloseAwards()
    {
        _awardAchievementId = null;
        _awardAchievementTitle = string.Empty;
        _awards = [];
        _awardsLoading = false;
        _awardToRevoke = null;
    }

    private void RequestDeleteCriteria()
    {
        if (_selectedAchievementId.HasValue)
            _confirmCriteriaDelete = true;
    }

    private void CancelDeleteCriteria()
    {
        _confirmCriteriaDelete = false;
    }

    private async Task ConfirmDeleteCriteriaAsync()
    {
        if (!_selectedAchievementId.HasValue)
            return;

        ClearNotifications();
        _isSaving = true;
        try
        {
            var result = await AchievementManagementService.DeleteCriteriaAsync(
                _currentUserId,
                _currentRole,
                CourseId,
                Year,
                _selectedAchievementId.Value);
            if (result.Status == AchievementManagementStatus.Success && result.Achievement is not null)
            {
                _confirmCriteriaDelete = false;
                Upsert(result.Achievement);
                SelectAchievement(result.Achievement);
                _message = "Критерий удалён.";
            }
            else
            {
                _error = AchievementError(result.Status, "Не удалось удалить критерий.");
            }
        }
        catch
        {
            _error = "Не удалось удалить критерий.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Upsert(ManagedAchievementDto achievement)
    {
        var index = _achievements.FindIndex(item => item.Id == achievement.Id);
        if (index >= 0)
            _achievements[index] = achievement;
        else
            _achievements.Add(achievement);
        _achievements = _achievements.OrderBy(item => item.Title).ToList();
    }

    private async Task LoadAuditAsync(bool surfaceError = true)
    {
        _auditLoading = true;
        try
        {
            var result = await AchievementManagementService.GetAwardAuditAsync(
                _currentUserId,
                _currentRole,
                CourseId,
                Year,
                limit: 100);
            if (result.Status == AchievementManagementStatus.Success)
                _auditEvents = result.AuditEvents?.ToList() ?? [];
            else if (surfaceError)
                _error = AchievementError(result.Status, "Не удалось загрузить журнал аудита.");
        }
        catch
        {
            if (surfaceError)
                _error = "Не удалось загрузить журнал аудита.";
        }
        finally
        {
            _auditLoading = false;
        }
    }

    private void ResetCriteria()
    {
        _criteriaExpression = string.Empty;
        _criteriaScope = "SameMark";
        _criteriaEnabled = true;
        _confirmCriteriaDelete = false;
    }

    private void ClearNotifications()
    {
        _error = null;
        _message = null;
    }

    private static string RarityLabel(AchievementRarity rarity) => rarity switch
    {
        AchievementRarity.Rare => "Редкая",
        AchievementRarity.Epic => "Эпическая",
        AchievementRarity.Legendary => "Легендарная",
        _ => "Обычная"
    };

    private static string AuditEventLabel(AchievementAwardAuditEventType eventType) =>
        eventType == AchievementAwardAuditEventType.Granted ? "Выдано" : "Отозвано";

    private static string AuditReasonLabel(AchievementAwardAuditReason reason) => reason switch
    {
        AchievementAwardAuditReason.CriteriaMatched => "Критерий выполнен",
        AchievementAwardAuditReason.AchievementDeletion => "Удаление достижения",
        _ => "Ручной отзыв"
    };

    private static string AuditActorLabel(AchievementAwardAuditEventDto auditEvent)
    {
        if (auditEvent.ActorRole == AchievementAwardAuditActorRole.System)
            return "Система";

        var role = auditEvent.ActorRole == AchievementAwardAuditActorRole.Administrator
            ? "Администратор"
            : "Преподаватель";
        return auditEvent.ActorId.HasValue
            ? $"{role}: {auditEvent.ActorId}"
            : role;
    }

    private static string FormatAuditDate(DateTime value) =>
        value.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss");

    private static string AchievementError(
        AchievementManagementStatus status,
        string fallback)
    {
        return status switch
        {
            AchievementManagementStatus.AccessDenied => "У вас нет доступа к достижениям этого курса.",
            AchievementManagementStatus.CourseNotFound => "Экземпляр курса не найден.",
            AchievementManagementStatus.AchievementNotFound => "Достижение не найдено.",
            AchievementManagementStatus.CriteriaNotFound => "Критерий достижения не найден.",
            AchievementManagementStatus.AwardNotFound => "У указанного студента уже нет этой ачивки.",
            AchievementManagementStatus.InvalidAchievement => "Проверьте название, описание и трек достижения.",
            AchievementManagementStatus.InvalidCriteria => "Критерий должен содержать хотя бы один тег.",
            AchievementManagementStatus.DuplicateTitle => "В этом курсе уже есть достижение с таким названием.",
            AchievementManagementStatus.AwardsConfirmationRequired => "Подтвердите отзыв всех выдач.",
            AchievementManagementStatus.HasDependencies => "Сначала удалите связи достижения в графе.",
            _ => fallback
        };
    }
}
