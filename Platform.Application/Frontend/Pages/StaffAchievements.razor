@page "/staff/courses/{CourseId:guid}/{Year:int}/achievements"
@attribute [Authorize(Roles = "teacher,administrator")]
@inject IJSRuntime JsRuntime

<PageTitle>Достижения курса — Платформа достижений</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <a class="text-decoration-none" href="staff/courses/@CourseId/@Year">← Вернуться в кабинет курса</a>
        <h1 class="mt-2 mb-1">Достижения и критерии</h1>
        <p class="text-muted mb-0">Экземпляр курса за @Year год</p>
    </div>
    <button class="btn btn-primary" @onclick="StartCreate">Новое достижение</button>
</div>

@if (_isLoading)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">Загрузка достижений...</span>
    </div>
}
else
{
    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (_message is not null)
    {
        <div class="alert alert-success">@_message</div>
    }

    <div class="row g-4">
        <div class="col-xl-7">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h2 class="h4 mb-0">Достижения (@_achievements.Count)</h2>
                        <input class="form-control" style="max-width: 20rem"
                               placeholder="Поиск по названию"
                               @bind="_search" @bind:event="oninput" />
                    </div>

                    @if (FilteredAchievements.Count == 0)
                    {
                        <div class="alert alert-secondary mb-0">Достижения не найдены.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col">Название</th>
                                        <th scope="col">Редкость</th>
                                        <th scope="col">Критерий</th>
                                        <th scope="col" class="text-end">Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var achievement in FilteredAchievements)
                                    {
                                        <tr class="@(achievement.Id == _selectedAchievementId ? "table-primary" : null)">
                                            <td>
                                                <div class="fw-semibold">@achievement.Title</div>
                                                <small class="text-muted">@achievement.Track</small>
                                                @if (achievement.AwardCount > 0)
                                                {
                                                    <button type="button"
                                                            class="badge bg-info text-dark border-0 ms-1"
                                                            title="Показать студентов"
                                                            disabled="@_isSaving"
                                                            @onclick="() => ToggleAwardsAsync(achievement)">
                                                        выдано: @achievement.AwardCount
                                                    </button>
                                                }
                                                @if (achievement.HasDependencies)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1">есть связи</span>
                                                }
                                            </td>
                                            <td>@RarityLabel(achievement.Rarity)</td>
                                            <td>
                                                @if (achievement.Criteria is null)
                                                {
                                                    <span class="text-muted">Не задан</span>
                                                }
                                                else
                                                {
                                                    <span class="badge @(achievement.Criteria.IsEnabled ? "bg-success" : "bg-secondary")">
                                                        @(achievement.Criteria.IsEnabled ? "Включён" : "Отключён")
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end text-nowrap">
                                                <button class="btn btn-sm btn-outline-primary me-2"
                                                        @onclick="() => SelectAchievement(achievement)">
                                                    Изменить
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        disabled="@(achievement.HasDependencies || _isSaving)"
                                                        title="@(achievement.HasDependencies ? "Сначала удалите связи графа" : null)"
                                                        @onclick="() => DeleteAchievementAsync(achievement)">
                                                    Удалить
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (_awardAchievementId.HasValue)
                    {
                        <div class="border rounded p-3 mt-3">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div>
                                    <h3 class="h6 mb-1">Студенты, получившие ачивку</h3>
                                    <div class="text-muted small">@_awardAchievementTitle</div>
                                </div>
                                <button type="button" class="btn-close" aria-label="Закрыть"
                                        @onclick="CloseAwards"></button>
                            </div>

                            @if (_awardsLoading)
                            {
                                <div class="text-muted small">Загрузка...</div>
                            }
                            else if (_awards.Count == 0)
                            {
                                <div class="text-muted small">Активных выдач нет.</div>
                            }
                            else
                            {
                                <div class="list-group">
                                    @foreach (var award in _awards)
                                    {
                                        <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <code>@award.StudentId</code>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    disabled="@_isSaving"
                                                    @onclick="() => RevokeAwardAsync(award)">
                                                Отозвать
                                            </button>
                                        </div>
                                    }
                                </div>
                            }

                            <p class="text-muted small mb-0 mt-2">
                                После отзыва студент сможет получить ачивку снова, если критерий будет выполнен при следующей обработке.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h4">@(_selectedAchievementId.HasValue ? "Редактирование достижения" : "Новое достижение")</h2>
                    <div class="mb-3">
                        <label class="form-label" for="achievement-title">Название</label>
                        <input id="achievement-title" class="form-control" maxlength="200" @bind="_title" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="achievement-description">Описание</label>
                        <textarea id="achievement-description" class="form-control" rows="3" maxlength="2000" @bind="_description"></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="achievement-rarity">Редкость</label>
                            <select id="achievement-rarity" class="form-select" @bind="_rarity">
                                <option value="common">Обычная</option>
                                <option value="rare">Редкая</option>
                                <option value="epic">Эпическая</option>
                                <option value="legendary">Легендарная</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="achievement-track">Трек</label>
                            <input id="achievement-track" class="form-control" maxlength="100" @bind="_track" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label" for="achievement-lab">ID лабораторной работы</label>
                        <input id="achievement-lab" class="form-control" placeholder="Необязательно, GUID" @bind="_labId" />
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary" disabled="@_isSaving" @onclick="SaveAchievementAsync">
                            @(_isSaving ? "Сохранение..." : "Сохранить достижение")
                        </button>
                        @if (_selectedAchievementId.HasValue)
                        {
                            <button class="btn btn-outline-secondary" disabled="@_isSaving" @onclick="StartCreate">Отмена</button>
                        }
                    </div>
                </div>
            </div>

            @if (_selectedAchievementId.HasValue)
            {
                <div class="card">
                    <div class="card-body">
                        <h2 class="h4">Критерий получения</h2>
                        <p class="text-muted small">
                            Укажите теги ведомости через запятую. Пустой критерий не сохраняется.
                        </p>
                        <div class="mb-3">
                            <label class="form-label" for="criteria-expression">Выражение</label>
                            <textarea id="criteria-expression" class="form-control" rows="3" maxlength="1000"
                                      placeholder="например: lab_completed, score_high"
                                      @bind="_criteriaExpression"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="criteria-scope">Область проверки</label>
                            <select id="criteria-scope" class="form-select" @bind="_criteriaScope">
                                <option value="sameMark">Одна отметка</option>
                                <option value="acrossCourse">Весь курс</option>
                                <option value="allLabs">Все лабораторные</option>
                            </select>
                        </div>
                        <div class="form-check mb-3">
                            <input id="criteria-enabled" class="form-check-input" type="checkbox" @bind="_criteriaEnabled" />
                            <label class="form-check-label" for="criteria-enabled">Критерий включён</label>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" disabled="@_isSaving" @onclick="SaveCriteriaAsync">
                                Сохранить критерий
                            </button>
                            @if (_selectedAchievement?.Criteria is not null)
                            {
                                <button class="btn btn-outline-danger" disabled="@_isSaving" @onclick="DeleteCriteriaAsync">
                                    Удалить критерий
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid CourseId { get; set; }
    [Parameter] public int Year { get; set; }

    private bool _isLoading = true;
    private bool _isSaving;
    private string? _error;
    private string? _message;
    private string _search = string.Empty;
    private List<ManagedAchievement> _achievements = [];
    private Guid? _selectedAchievementId;
    private ManagedAchievement? _selectedAchievement;
    private string _title = string.Empty;
    private string _description = string.Empty;
    private string _rarity = "common";
    private string _track = "default";
    private string _labId = string.Empty;
    private string _criteriaExpression = string.Empty;
    private string _criteriaScope = "sameMark";
    private bool _criteriaEnabled = true;
    private Guid? _awardAchievementId;
    private string _awardAchievementTitle = string.Empty;
    private bool _awardsLoading;
    private List<ManagedAward> _awards = [];

    private List<ManagedAchievement> FilteredAchievements => _achievements
        .Where(achievement => string.IsNullOrWhiteSpace(_search) ||
            achievement.Title.Contains(_search, StringComparison.CurrentCultureIgnoreCase))
        .ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var result = await JsRuntime.InvokeAsync<AchievementListResult>(
                "platformApi.getManagedAchievements",
                CourseId,
                Year);
            if (result.Success)
                _achievements = result.Achievements ?? [];
            else
                _error = result.Message ?? "Не удалось загрузить достижения курса.";
        }
        catch
        {
            _error = NetworkError;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void StartCreate()
    {
        _selectedAchievementId = null;
        _selectedAchievement = null;
        _title = string.Empty;
        _description = string.Empty;
        _rarity = "common";
        _track = "default";
        _labId = string.Empty;
        ResetCriteria();
        ClearNotifications();
    }

    private void SelectAchievement(ManagedAchievement achievement)
    {
        _selectedAchievementId = achievement.Id;
        _selectedAchievement = achievement;
        _title = achievement.Title;
        _description = achievement.Description;
        _rarity = achievement.Rarity;
        _track = achievement.Track;
        _labId = achievement.LabId?.ToString() ?? string.Empty;
        _criteriaExpression = achievement.Criteria?.Expression ?? string.Empty;
        _criteriaScope = achievement.Criteria?.Scope ?? "sameMark";
        _criteriaEnabled = achievement.Criteria?.IsEnabled ?? true;
        ClearNotifications();
    }

    private async Task SaveAchievementAsync()
    {
        ClearNotifications();
        if (string.IsNullOrWhiteSpace(_title))
        {
            _error = "Укажите название достижения.";
            return;
        }

        Guid? labId = null;
        if (!string.IsNullOrWhiteSpace(_labId))
        {
            if (!Guid.TryParse(_labId, out var parsedLabId))
            {
                _error = "ID лабораторной работы должен иметь формат GUID.";
                return;
            }
            labId = parsedLabId;
        }

        _isSaving = true;
        try
        {
            var request = new
            {
                title = _title,
                description = _description,
                rarity = _rarity,
                track = _track,
                labId
            };
            var result = await JsRuntime.InvokeAsync<AchievementCommandResult>(
                "platformApi.saveManagedAchievement",
                CourseId,
                Year,
                _selectedAchievementId,
                request);
            if (result.Success && result.Achievement is not null)
            {
                Upsert(result.Achievement);
                SelectAchievement(result.Achievement);
                _message = "Достижение сохранено.";
            }
            else
            {
                _error = result.Message ?? "Не удалось сохранить достижение.";
            }
        }
        catch
        {
            _error = NetworkError;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveCriteriaAsync()
    {
        if (!_selectedAchievementId.HasValue)
            return;

        ClearNotifications();
        _isSaving = true;
        try
        {
            var result = await JsRuntime.InvokeAsync<AchievementCommandResult>(
                "platformApi.saveManagedAchievementCriteria",
                CourseId,
                Year,
                _selectedAchievementId.Value,
                new
                {
                    expression = _criteriaExpression,
                    scope = _criteriaScope,
                    isEnabled = _criteriaEnabled
                });
            if (result.Success && result.Achievement is not null)
            {
                Upsert(result.Achievement);
                SelectAchievement(result.Achievement);
                _message = "Критерий сохранён.";
            }
            else
            {
                _error = result.Message ?? "Не удалось сохранить критерий.";
            }
        }
        catch
        {
            _error = NetworkError;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteAchievementAsync(ManagedAchievement achievement)
    {
        var warning = achievement.AwardCount > 0
            ? $"Удалить «{achievement.Title}» и отозвать его у {achievement.AwardCount} студентов?"
            : $"Удалить достижение «{achievement.Title}»?";
        if (!await JsRuntime.InvokeAsync<bool>("confirm", warning))
            return;

        ClearNotifications();
        _isSaving = true;
        try
        {
            var result = await JsRuntime.InvokeAsync<AchievementCommandResult>(
                "platformApi.deleteManagedAchievement",
                CourseId,
                Year,
                achievement.Id,
                achievement.AwardCount > 0);
            if (result.Success)
            {
                _achievements.RemoveAll(item => item.Id == achievement.Id);
                if (_awardAchievementId == achievement.Id)
                    CloseAwards();
                if (_selectedAchievementId == achievement.Id)
                    StartCreate();
                _message = achievement.AwardCount > 0
                    ? "Достижение удалено, связанные выдачи отозваны."
                    : "Достижение удалено.";
            }
            else
            {
                _error = result.Message ?? "Не удалось удалить достижение.";
            }
        }
        catch
        {
            _error = NetworkError;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ToggleAwardsAsync(ManagedAchievement achievement)
    {
        if (_awardAchievementId == achievement.Id)
        {
            CloseAwards();
            return;
        }

        _awardAchievementId = achievement.Id;
        _awardAchievementTitle = achievement.Title;
        _awards = [];
        _awardsLoading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var result = await JsRuntime.InvokeAsync<AchievementAwardsResult>(
                "platformApi.getManagedAchievementAwards",
                CourseId,
                Year,
                achievement.Id);
            if (result.Success)
                _awards = result.Awards ?? [];
            else
                _error = result.Message ?? "Не удалось загрузить список студентов.";
        }
        catch
        {
            _error = NetworkError;
        }
        finally
        {
            _awardsLoading = false;
        }
    }

    private async Task RevokeAwardAsync(ManagedAward award)
    {
        if (!_awardAchievementId.HasValue ||
            !await JsRuntime.InvokeAsync<bool>(
                "confirm",
                $"Отозвать ачивку у студента {award.StudentId}? Студент сможет получить её повторно."))
        {
            return;
        }

        ClearNotifications();
        _isSaving = true;
        try
        {
            var result = await JsRuntime.InvokeAsync<AchievementCommandResult>(
                "platformApi.revokeManagedAchievementAward",
                CourseId,
                Year,
                _awardAchievementId.Value,
                award.StudentId);
            if (result.Success && result.Achievement is not null)
            {
                _awards.RemoveAll(item => item.StudentId == award.StudentId);
                Upsert(result.Achievement);
                if (_selectedAchievementId == result.Achievement.Id)
                    _selectedAchievement = result.Achievement;
                _message = $"Ачивка отозвана у студента {award.StudentId}.";
            }
            else
            {
                _error = result.Message ?? "Не удалось отозвать ачивку у студента.";
            }
        }
        catch
        {
            _error = NetworkError;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void CloseAwards()
    {
        _awardAchievementId = null;
        _awardAchievementTitle = string.Empty;
        _awards = [];
        _awardsLoading = false;
    }

    private async Task DeleteCriteriaAsync()
    {
        if (!_selectedAchievementId.HasValue ||
            !await JsRuntime.InvokeAsync<bool>("confirm", "Удалить критерий? Достижение перестанет выдаваться автоматически."))
        {
            return;
        }

        ClearNotifications();
        _isSaving = true;
        try
        {
            var result = await JsRuntime.InvokeAsync<AchievementCommandResult>(
                "platformApi.deleteManagedAchievementCriteria",
                CourseId,
                Year,
                _selectedAchievementId.Value);
            if (result.Success && result.Achievement is not null)
            {
                Upsert(result.Achievement);
                SelectAchievement(result.Achievement);
                _message = "Критерий удалён.";
            }
            else
            {
                _error = result.Message ?? "Не удалось удалить критерий.";
            }
        }
        catch
        {
            _error = NetworkError;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Upsert(ManagedAchievement achievement)
    {
        var index = _achievements.FindIndex(item => item.Id == achievement.Id);
        if (index >= 0)
            _achievements[index] = achievement;
        else
            _achievements.Add(achievement);
        _achievements = _achievements.OrderBy(item => item.Title).ToList();
    }

    private void ResetCriteria()
    {
        _criteriaExpression = string.Empty;
        _criteriaScope = "sameMark";
        _criteriaEnabled = true;
    }

    private void ClearNotifications()
    {
        _error = null;
        _message = null;
    }

    private static string RarityLabel(string rarity) => rarity switch
    {
        "rare" => "Редкая",
        "epic" => "Эпическая",
        "legendary" => "Легендарная",
        _ => "Обычная"
    };

    private const string NetworkError =
        "Не удалось связаться с сервером. Проверьте подключение и повторите запрос.";

    private sealed class ManagedAchievement
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Rarity { get; set; } = "common";
        public string Track { get; set; } = "default";
        public Guid? LabId { get; set; }
        public Guid CourseId { get; set; }
        public int Year { get; set; }
        public bool HasAwards { get; set; }
        public int AwardCount { get; set; }
        public bool HasDependencies { get; set; }
        public ManagedCriteria? Criteria { get; set; }
    }

    private sealed class ManagedCriteria
    {
        public Guid Id { get; set; }
        public string Expression { get; set; } = string.Empty;
        public string Scope { get; set; } = "sameMark";
        public bool IsEnabled { get; set; }
    }

    private sealed class ManagedAward
    {
        public Guid StudentId { get; set; }
    }

    private sealed class AchievementListResult
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public List<ManagedAchievement>? Achievements { get; set; }
    }

    private sealed class AchievementCommandResult
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public ManagedAchievement? Achievement { get; set; }
    }

    private sealed class AchievementAwardsResult
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public List<ManagedAward>? Awards { get; set; }
    }
}
