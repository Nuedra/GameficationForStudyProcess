@page "/achievements"
@attribute [Authorize(Roles = "student")]
@inject IJSRuntime JsRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStudentCourseService StudentCourseService

<PageTitle>Достижения — Платформа достижений</PageTitle>

<h1>Достижения</h1>

@if (_isLoading)
{
    <div class="d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">Загрузка...</span>
    </div>
}
else if (_pageError != null)
{
    <div class="alert alert-danger mt-3">
        @_pageError
        <button class="btn btn-outline-danger btn-sm ms-2" @onclick="LoadPageAsync">Повторить</button>
    </div>
}
else if (!_isAuthenticated)
{
    <div class="alert alert-warning mt-3">
        <span class="oi oi-warning me-2" aria-hidden="true"></span>
        Необходимо <a href="login">войти в систему</a>, чтобы просматривать достижения.
    </div>
}
else if (_courses == null || _courses.Count == 0)
{
    <div class="alert alert-info mt-3">Курсы не найдены. Обратитесь к администратору.</div>
}
else
{
    @if (_courses.Count > 1)
    {
        <div class="mb-3" style="max-width: 420px;">
            <label for="courseSelect" class="form-label">Курс</label>
            <select id="courseSelect" class="form-select" @onchange="OnCourseChangedAsync">
                @foreach (var course in _courses)
                {
                    <option value="@($"{course.Id}:{course.Year}")">@course.Title</option>
                }
            </select>
        </div>
    }
    else
    {
        <p class="text-muted mb-3">
            <span class="oi oi-book me-1" aria-hidden="true"></span>
            @_courses[0].Title &nbsp;·&nbsp; @_courses[0].Year
        </p>
    }

    <div class="achievement-legend mb-3">
        <div class="legend-item">
            <span class="legend-dot legend-earned"></span>
            <span>Заработанная ачивка</span>
        </div>
        <div class="legend-item">
            <span class="legend-dot legend-available"></span>
            <span>Доступная для получения</span>
        </div>
        <div class="legend-item">
            <span class="legend-dot legend-locked"></span>
            <span>Недоступная ачивка</span>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 mb-2">
        <button class="btn btn-primary btn-sm" @onclick="RefreshGraphAsync" disabled="@_graphLoading">
            @if (_graphLoading)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                <span>Обновление...</span>
            }
            else
            {
                <span class="oi oi-reload me-1" aria-hidden="true"></span>
                <span>Обновить граф</span>
            }
        </button>
    </div>

    @if (_graphError != null)
    {
        <div class="alert alert-danger py-2">@_graphError</div>
    }

    <div id="@_graphElementId" class="achievement-graph-host"></div>
}

@code {
    private const string GraphElementId = "achievements-graph-main";
    private readonly string _graphElementId = GraphElementId;

    private bool _isLoading = true;
    private bool _isAuthenticated;
    private IReadOnlyList<CourseDto>? _courses;
    private Guid _selectedCourseId;
    private int _selectedYear;
    private bool _graphLoading;
    private string? _graphError;
    private string? _pageError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        _isLoading = true;
        _pageError = null;
        StateHasChanged();

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (!authenticationState.User.TryGetUserId(out var studentId))
            {
                _isAuthenticated = false;
                return;
            }

            _isAuthenticated = true;
            _courses = await StudentCourseService.GetCoursesAsync(studentId);
            if (_courses.Count > 0)
            {
                _selectedCourseId = _courses[0].Id;
                _selectedYear = _courses[0].Year;
            }
        }
        catch
        {
            _pageError = "Не удалось связаться с сервером. Проверьте подключение и повторите запрос.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }

        if (_isAuthenticated && _pageError == null && _selectedCourseId != Guid.Empty)
            await LoadGraphAsync(false);
    }

    private async Task OnCourseChangedAsync(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        var colon = val.IndexOf(':');
        if (colon > 0
            && Guid.TryParse(val[..colon], out var courseId)
            && int.TryParse(val[(colon + 1)..], out var year))
        {
            _selectedCourseId = courseId;
            _selectedYear = year;
            await LoadGraphAsync(false);
        }
    }

    private async Task RefreshGraphAsync()
    {
        await LoadGraphAsync(true);
    }

    private async Task LoadGraphAsync(bool useRefresh)
    {
        if (_selectedCourseId == Guid.Empty) return;

        _graphLoading = true;
        _graphError = null;
        StateHasChanged();

        try
        {
            var jsFunc = useRefresh
                ? "achievementGraphHost.renderRefresh"
                : "achievementGraphHost.render";
            var error = await JsRuntime.InvokeAsync<string>(
                jsFunc, _graphElementId, _selectedCourseId, _selectedYear);
            _graphError = string.IsNullOrWhiteSpace(error) ? null : error;
        }
        catch
        {
            _graphError = "Не удалось загрузить граф достижений. Повторите запрос.";
        }
        finally
        {
            _graphLoading = false;
            StateHasChanged();
        }
    }

}
