@page "/staff/courses"
@attribute [Authorize(Roles = "teacher,administrator")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStaffCourseService StaffCourseService

<PageTitle>Курсы кабинета — Платформа достижений</PageTitle>

<h1>Экземпляры курсов</h1>
<p class="text-muted">
    Список загружается через read-only контракт LMS с учётом вашей роли и активных назначений.
</p>

@if (_isLoading)
{
    <div class="d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">Загрузка...</span>
    </div>
}
else if (_error is not null)
{
    <div class="alert alert-danger mt-3">
        @_error
        <button class="btn btn-outline-danger btn-sm ms-2" @onclick="LoadCoursesAsync">Повторить</button>
    </div>
}
else if (_courses is null || _courses.Count == 0)
{
    <div class="alert alert-info mt-3">
        Доступные экземпляры курсов не найдены.
    </div>
}
else
{
    <div class="row g-3 mt-1">
        @foreach (var course in _courses)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@course.Title</h5>
                            <span class="badge bg-secondary ms-2">@course.Year</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(course.Description))
                        {
                            <p class="card-text text-muted small">@course.Description</p>
                        }
                    </div>
                    <div class="card-footer bg-transparent border-top-0 pt-0">
                        <a class="btn btn-outline-primary btn-sm"
                           href="staff/courses/@course.Id/@course.Year">
                            Открыть кабинет курса
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool _isLoading = true;
    private IReadOnlyList<CourseDto>? _courses;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadCoursesAsync();
    }

    private async Task LoadCoursesAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authenticationState.User;
            if (!user.TryGetUserId(out var userId) || !user.TryGetUserRole(out var role))
            {
                _error = "Не удалось определить текущего пользователя.";
                return;
            }

            var result = await StaffCourseService.GetCoursesAsync(userId, role);
            if (result.Status == StaffCourseQueryStatus.Success)
                _courses = result.Courses;
            else
                _error = "У вас нет доступа к списку курсов.";
        }
        catch
        {
            _error = "Не удалось загрузить курсы кабинета.";
        }
        finally
        {
            _isLoading = false;
        }
    }

}
