@page "/achievement-graph-demo"
@page "/student/courses/{CourseId:guid}/{Year:int}/achievement-graph"
@inject IJSRuntime JsRuntime

<PageTitle>Граф достижений</PageTitle>

<h1>Граф достижений</h1>

<p>
    Курс: <code>@ResolvedCourseId</code>, год: <code>@ResolvedYear</code>
</p>

<button class="btn btn-primary" @onclick="DrawGraphAsync" disabled="@_isLoading">
    @(_isLoading ? "Загрузка..." : "Отрисовать граф")
</button>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <p class="achievement-graph-message">@_message</p>
}

<div id="@_graphElementId" class="achievement-graph-host"></div>

@code {
    private static readonly Guid DefaultCourseId =
        Guid.Parse("a1000000-0000-0000-0000-000000000001");

    private readonly string _graphElementId = $"achievement-graph-{Guid.NewGuid():N}";
    private bool _isLoading;
    private string? _message;

    [Parameter]
    public Guid CourseId { get; set; } = DefaultCourseId;

    [Parameter]
    public int Year { get; set; } = 2026;

    private Guid ResolvedCourseId => CourseId == Guid.Empty
        ? DefaultCourseId
        : CourseId;

    private int ResolvedYear => Year <= 0
        ? 2026
        : Year;

    private async Task DrawGraphAsync()
    {
        _isLoading = true;
        _message = null;

        try
        {
            var errorMessage = await JsRuntime.InvokeAsync<string>(
                "achievementGraphHost.render",
                _graphElementId,
                ResolvedCourseId,
                ResolvedYear,
                1100,
                650);

            _message = string.IsNullOrWhiteSpace(errorMessage)
                ? "Граф отрисован."
                : errorMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
