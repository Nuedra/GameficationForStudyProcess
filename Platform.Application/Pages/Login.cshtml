@page "/login"
@model Platform.Application.Pages.LoginModel

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Вход — Платформа достижений</title>
    <link href="~/css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <main class="container">
        <div class="row justify-content-center mt-5">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <div class="login-icon mb-2">🎓</div>
                            <h1 class="h2 card-title mb-1">Платформа достижений</h1>
                            <p class="text-muted small mb-0">Введите ID пользователя</p>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger">@Model.ErrorMessage</div>
                        }

                        <form method="post">
                            <input type="hidden" asp-for="ReturnUrl" />
                            <div class="mb-3">
                                <label asp-for="UserId" class="form-label">ID пользователя</label>
                                <input asp-for="UserId" class="form-control"
                                       placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                                       autocomplete="off" autofocus />
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Войти</button>
                        </form>

                        <p class="text-muted text-center mt-3 small mb-0">
                            Тестовый ID: <code>b0000000-0000-0000-0000-000000000001</code>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
