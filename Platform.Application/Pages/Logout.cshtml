@page "/logout"
@model Platform.Application.Pages.LogoutModel

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Выход — Платформа достижений</title>
    <link href="~/css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <main class="container">
        <div class="card mx-auto mt-5" style="max-width: 32rem;">
            <div class="card-body p-4">
                <h1 class="h3">Завершить сеанс?</h1>
                <p class="text-muted">Для выхода требуется отдельный защищённый POST-запрос.</p>
                <form method="post" class="d-flex gap-2">
                    <button type="submit" class="btn btn-outline-danger">Выйти</button>
                    <a href="/" class="btn btn-outline-secondary">Отмена</a>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
